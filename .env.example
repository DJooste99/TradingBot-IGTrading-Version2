# Copy to .env and fill in. Never commit .env.
IG_DEMO_API_KEY=
IG_DEMO_USERNAME=
IG_DEMO_PASSWORD=
IG_LIVE_API_KEY=
IG_LIVE_USERNAME=
IG_LIVE_PASSWORD=

# Claude is reached through the Claude Code CLI with your Claude subscription (run `claude` once and log in).
# The bot finds `claude` on PATH or in the VS Code extension; set this only if it is installed elsewhere.
# CLAUDE_CLI=C:\path\to\claude.exe

# Engine loop interval in seconds, and whether to start trading on server boot
ENGINE_POLL_SECONDS=30
ENGINE_AUTOSTART=false
